@model NovelDetailsViewModel
@{
    ViewData["Title"] = Model.Novel.Title;
}

<div class="py-5 text-white" style="background: linear-gradient(135deg, #0f172a 0%, #0f2942 100%);">
    <div class="container">
        <div class="row g-4 align-items-center">
            <div class="col-md-3 text-center">
                <img src="@Model.Novel.CoverImageUrl" 
                     class="img-fluid rounded-4 shadow-lg border border-secondary border-opacity-30" 
                     style="max-height: 360px; width: 100%; object-fit: cover;" 
                     alt="@Model.Novel.Title"
                     onerror="handleImageError(this)">
            </div>
            <div class="col-md-9">
                <span class="badge bg-info bg-opacity-20 text-info border border-info border-opacity-30 px-3 py-2 rounded-pill mb-3 d-inline-flex align-items-center gap-2">
                    <i class="@Model.Novel.Category.IconClass"></i><span>@Model.Novel.Category.Name</span>
                </span>
                <h1 class="display-5 fw-bold mb-2">@Model.Novel.Title</h1>
                <div class="d-flex flex-wrap align-items-center gap-4 text-slate-300 mb-4">
                    <span class="d-inline-flex align-items-center gap-2"><i class="fas fa-user-nib text-info"></i><span>الكاتب: <strong>@Model.Novel.Author</strong></span></span>
                    <span class="d-inline-flex align-items-center gap-2"><i class="fas fa-star text-warning"></i><span>التقييم: <strong>@Model.Novel.Rating / 5.0</strong></span></span>
                    <span class="d-inline-flex align-items-center gap-2"><i class="fas fa-eye text-teal"></i><span>المشاهدات: <strong>@Model.Novel.ViewsCount</strong></span></span>
                    <span class="d-inline-flex align-items-center gap-2"><i class="fas fa-book-open text-success"></i><span>عدد الفصول: <strong>@Model.Chapters.Count</strong></span></span>
                </div>
                <p class="fs-6 text-slate-300 leading-relaxed mb-4" style="max-width: 800px;">
                    @Model.Novel.Description
                </p>
                
                @if (Model.Chapters.Any())
                {
                    var firstFreeOrPurchased = Model.Chapters.FirstOrDefault(c => c.IsFree || c.IsPurchased) ?? Model.Chapters.First();
                    <a asp-controller="Chapters" asp-action="Read" asp-route-id="@firstFreeOrPurchased.Id" class="btn btn-primary btn-lg rounded-pill px-4 fw-bold shadow d-inline-flex align-items-center gap-2">
                        <i class="fas fa-play"></i><span>ابدأ القراءة الآن (الفصل @firstFreeOrPurchased.ChapterNumber)</span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 py-3 d-flex align-items-center justify-content-between">
                    <h4 class="fw-bold mb-0 text-dark d-inline-flex align-items-center gap-2"><i class="fas fa-list-ol text-teal"></i><span>فهرس الفصول</span></h4>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-2">
                        إجمالي الفصول: @Model.Chapters.Count
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush rounded-bottom-4">
                        @foreach (var ch in Model.Chapters)
                        {
                            <div class="list-group-item p-3 d-flex align-items-center justify-content-between flex-wrap gap-3">
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge bg-teal bg-opacity-10 text-teal rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 1rem; background-color: rgba(13, 148, 136, 0.1); color: #0d9488;">
                                        @ch.ChapterNumber
                                    </span>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">@ch.Title</h6>
                                        <small class="text-muted d-inline-flex align-items-center gap-1"><i class="far fa-clock"></i><span>تاريخ النشر: @ch.CreatedAt.ToString("yyyy/MM/dd")</span></small>
                                    </div>
                                </div>

                                <div class="d-flex align-items-center gap-3 ms-auto">
                                    @if (ch.IsFree)
                                    {
                                        <span class="badge badge-free px-3 py-2 rounded-pill fw-bold d-inline-flex align-items-center gap-2">
                                            <i class="fas fa-gift"></i><span>مجانًا</span>
                                        </span>
                                        <a asp-controller="Chapters" asp-action="Read" asp-route-id="@ch.Id" class="btn btn-outline-success btn-sm rounded-pill px-4 fw-bold d-inline-flex align-items-center gap-2">
                                            <span>قراءة</span><i class="fas fa-book-open me-1"></i>
                                        </a>
                                    }
                                    else if (ch.IsPurchased)
                                    {
                                        <span class="badge badge-owned px-3 py-2 rounded-pill fw-bold d-inline-flex align-items-center gap-2">
                                            <i class="fas fa-circle-check"></i><span>متاح للحساب</span>
                                        </span>
                                        <a asp-controller="Chapters" asp-action="Read" asp-route-id="@ch.Id" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold d-inline-flex align-items-center gap-2">
                                            <span>متابعة القراءة</span><i class="fas fa-arrow-left me-1"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge badge-paid px-3 py-2 rounded-pill fw-bold fs-6 d-inline-flex align-items-center gap-2">
                                            <i class="fas fa-coins"></i><span>@ch.Price.ToString("N2") ج.م</span>
                                        </span>
                                        <a asp-controller="Checkout" asp-action="Buy" asp-route-chapterId="@ch.Id" class="btn btn-warning btn-sm rounded-pill px-4 fw-bold text-dark shadow-sm d-inline-flex align-items-center gap-2">
                                            <span>شراء الفصل</span><i class="fas fa-cart-shopping me-1"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Info -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4 text-center">
                    <i class="fas fa-shield-halved text-success fs-1 mb-3"></i>
                    <h5 class="fw-bold text-dark">ضمان حماية المحتوى</h5>
                    <p class="small text-muted mb-0">
                        الفصول المدفوعة يتم تفعيلها فورًا في حسابك مع وصول دائم وقراءة مريحة بدون حدود من أي جهاز.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
