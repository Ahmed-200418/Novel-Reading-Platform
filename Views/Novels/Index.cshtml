@model IEnumerable<Novel>
@{
    ViewData["Title"] = "مكتبة الروايات الكاملة";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    int? selectedCat = ViewBag.SelectedCategoryId as int?;
}

<div class="py-4 text-white mb-4" style="background: linear-gradient(135deg, #0f172a 0%, #0f2942 100%);">
    <div class="container py-3">
        <h2 class="fw-bold mb-2 d-inline-flex align-items-center gap-2"><i class="fas fa-book-bookmark text-info"></i><span>مكتبة الروايات</span></h2>
        <p class="text-slate-300 mb-0">استكشف جميع الأعمال الروائية والقصصية المتاحة عبر المنصة.</p>
    </div>
</div>

<div class="container pb-5">
    <!-- Category & Filter Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="fw-bold text-dark ms-2 d-inline-flex align-items-center gap-2"><i class="fas fa-filter text-teal"></i><span>التصفية حسب التصنيف:</span></span>
                <a asp-action="Index" class="btn btn-sm @(!selectedCat.HasValue ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3 fw-bold">
                    الكل
                </a>
                @foreach (var cat in categories)
                {
                    <a asp-action="Index" asp-route-categoryId="@cat.Id" class="btn btn-sm @(selectedCat == cat.Id ? "btn-primary" : "btn-outline-secondary") rounded-pill px-3 fw-bold d-inline-flex align-items-center gap-2">
                        <i class="@cat.IconClass"></i><span>@cat.Name</span>
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- Novels Grid -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm my-4">
            <i class="fas fa-book-open text-muted fs-1 mb-3"></i>
            <h5 class="fw-bold text-dark">لم يتم العثور على أي روايات مطابقة</h5>
            <p class="text-muted">جرب البحث بكلمات أخرى أو اختر تصنيفاً مختلفاً.</p>
            <a asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold d-inline-flex align-items-center gap-2"><span>إعادة ضبط التصفية</span></a>
        </div>
    }
    else
    {
        <div class="row g-4 row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 justify-content-center">
            @foreach (var novel in Model)
            {
                <div class="col">
                    <div class="novel-card">
                        <div class="novel-cover-container">
                            <img src="@novel.CoverImageUrl" 
                                 class="novel-cover-img" 
                                 alt="@novel.Title"
                                 onerror="handleImageError(this)">
                            <span class="novel-badge-category">@novel.Category?.Name</span>
                        </div>
                        <div class="card-body d-flex flex-column p-3">
                            <div class="d-flex align-items-center justify-content-between text-muted small mb-2">
                                <span class="d-inline-flex align-items-center gap-2"><i class="fas fa-user-pen text-teal"></i><span>@novel.Author</span></span>
                                <span class="d-inline-flex align-items-center gap-1"><i class="fas fa-star text-warning"></i><span>@novel.Rating</span></span>
                            </div>
                            <h5 class="card-title fw-bold text-dark text-truncate mb-2" title="@novel.Title">@novel.Title</h5>
                            <p class="card-text text-muted small flex-grow-1 mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @novel.Description
                            </p>
                            <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                                <span class="d-inline-flex align-items-center gap-2 small text-muted"><i class="fas fa-list-ol text-teal"></i><span>@novel.Chapters.Count فصول</span></span>
                                <a asp-action="Details" asp-route-id="@novel.Id" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold d-inline-flex align-items-center gap-2">
                                    <span>تصفح الرواية</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
