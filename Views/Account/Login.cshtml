@model LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="py-5 bg-light" style="min-height: 80vh;">
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                            <i class="fas fa-user-lock fs-2"></i>
                        </div>
                        <h3 class="fw-bold text-dark">تسجيل الدخول</h3>
                        <p class="text-muted small">مرحباً بعودتك! أدخل بيانات حسابك لمتابعة القراءة.</p>
                    </div>

                    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <input asp-for="Email" class="form-control rounded-end-3" placeholder="reader@novelhub.com" />
                                <span class="input-group-text bg-light rounded-start-3"><i class="fas fa-envelope text-muted"></i></span>
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <input asp-for="Password" class="form-control rounded-end-3" placeholder="••••••••" />
                                <span class="input-group-text bg-light rounded-start-3"><i class="fas fa-key text-muted"></i></span>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 d-flex align-items-center justify-content-between">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mb-4">
                            <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                                تسجيل الدخول <i class="fas fa-right-to-bracket ms-1"></i>
                            </button>
                        </div>
                    </form>

                    <!-- Quick Demo Credentials Box -->
                    <div class="p-3 bg-light rounded-4 border">
                        <small class="fw-bold text-dark d-block mb-1"><i class="fas fa-key text-warning me-1"></i>حسابات للتجربة السريعة:</small>
                        <div class="small text-muted mb-1">
                            <strong>القارئ التجريبي:</strong> <code>reader@novelhub.com</code> / <code>User@123456</code>
                        </div>
                        <div class="small text-muted">
                            <strong>مسؤول النظام:</strong> <code>admin@novelhub.com</code> / <code>Admin@123456</code>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        <span class="text-muted small">ليس لديك حساب بعد؟</span>
                        <a asp-action="Register" class="fw-bold text-primary text-decoration-none ms-1">إنشاء حساب جديد</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
