@model List<Purchase>
@{
    ViewData["Title"] = "مكتبتي الفصول المشتراة";
    var orders = ViewBag.Orders as List<Order> ?? new List<Order>();
    string userFullName = ViewBag.UserFullName as string ?? "";
    string userEmail = ViewBag.UserEmail as string ?? "";
    decimal totalSpent = Model.Sum(p => p.PricePaid);
}

<div class="py-4 text-white" style="background: linear-gradient(135deg, #0f172a 0%, #0f2942 100%);">
    <div class="container py-3">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold fs-3 shadow-sm" style="width: 60px; height: 60px; background-color: #0d9488;">
                    <i class="fas fa-user"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-1">مرحباً بك، @userFullName</h3>
                    <div class="text-slate-300 small"><i class="fas fa-envelope me-1 text-info"></i>@userEmail</div>
                </div>
            </div>

            <div class="d-flex gap-3">
                <div class="bg-white bg-opacity-10 backdrop-blur rounded-4 p-3 text-center border border-light border-opacity-10" style="min-width: 140px;">
                    <span class="text-info d-block small">الفصول الممتلكة</span>
                    <h4 class="fw-bold mb-0 text-white">@Model.Count</h4>
                </div>
                <div class="bg-white bg-opacity-10 backdrop-blur rounded-4 p-3 text-center border border-light border-opacity-10" style="min-width: 140px;">
                    <span class="text-warning d-block small">إجمالي المدفوعات</span>
                    <h4 class="fw-bold mb-0 text-white">@totalSpent.ToString("N2") ج.م</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container py-5">
    <!-- Tabs Navigation -->
    <ul class="nav nav-pills custom-pills mb-4 gap-2" id="libraryTab" role="tablist">
        <li class="nav-item">
            <button class="nav-link active rounded-pill px-4 fw-bold" id="purchases-tab" data-bs-toggle="tab" data-bs-target="#purchases">
                <i class="fas fa-book-bookmark ms-1"></i>فصولي المشتراة (@Model.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4 fw-bold" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders">
                <i class="fas fa-receipt ms-1"></i>سجل المعاملات والفواتير (@orders.Count)
            </button>
        </li>
    </ul>

    <div class="tab-content" id="libraryTabContent">
        
        <!-- Tab 1: Purchased Chapters Grid -->
        <div class="tab-pane fade show active" id="purchases" role="tabpanel">
            @if (!Model.Any())
            {
                <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                    <i class="fas fa-box-open text-muted fs-1 mb-3"></i>
                    <h5 class="fw-bold text-dark">لم تقم بشراء أي فصول بعد</h5>
                    <p class="text-muted mb-3">تصفح مكتبة الروايات واكتشف الفصول المدفوعة الحصرية.</p>
                    <a asp-controller="Novels" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold">استكشف الروايات</a>
                </div>
            }
            else
            {
                <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-lg-3 justify-content-center">
                    @foreach (var p in Model)
                    {
                        <div class="col">
                            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden hover-shadow transition">
                                <div class="card-body p-4 d-flex flex-column">
                                    <div class="d-flex align-items-center gap-3 mb-3">
                                        <img src="@p.Chapter.Novel.CoverImageUrl" 
                                             style="width: 50px; height: 70px; object-fit: cover;" 
                                             class="rounded-3 shadow-sm" 
                                             alt="@p.Chapter.Novel.Title"
                                             onerror="handleImageError(this)">
                                        <div>
                                            <span class="badge bg-teal bg-opacity-10 text-teal rounded-pill mb-1" style="background-color: rgba(13, 148, 136, 0.1); color: #0d9488;">@p.Chapter.Novel.Title</span>
                                            <h6 class="fw-bold text-dark mb-0">@p.Chapter.Title</h6>
                                        </div>
                                    </div>
                                    <div class="small text-muted mb-3">
                                        <i class="fas fa-clock ms-1 text-secondary"></i>تاريخ الشراء: @p.PurchasedAt.ToString("yyyy/MM/dd - HH:mm")
                                    </div>
                                    <div class="mt-auto d-flex align-items-center justify-content-between pt-3 border-top">
                                        <span class="fw-bold text-success small"><i class="fas fa-check-circle ms-1"></i>مُفعّل بالكامل</span>
                                        <a asp-controller="Chapters" asp-action="Read" asp-route-id="@p.ChapterId" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold">
                                            قراءة الفصل <i class="fas fa-book-open me-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Tab 2: Orders & Transactions Table -->
        <div class="tab-pane fade" id="orders" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted">
                                <tr>
                                    <th class="ps-4 py-3">رقم الطلب</th>
                                    <th>الرواية والفصل</th>
                                    <th>المبلغ</th>
                                    <th>طريقة الدفع</th>
                                    <th>رقم المعاملة</th>
                                    <th>التاريخ</th>
                                    <th class="pe-4 text-center">الحالة</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in orders)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-dark">@o.OrderNumber</td>
                                        <td>
                                            <div class="fw-bold text-dark">@o.Chapter?.Novel?.Title</div>
                                            <div class="small text-muted">@o.Chapter?.Title</div>
                                        </td>
                                        <td class="fw-bold text-teal" style="color: #0d9488;">@o.Amount.ToString("N2") ج.م</td>
                                        <td>
                                            <span class="badge bg-secondary bg-opacity-10 text-dark">@(o.Payment?.PaymentMethod ?? "بطاقة ائتمانية")</span>
                                        </td>
                                        <td><code class="small">@(o.Payment?.TransactionReference ?? "TXN-AUTO")</code></td>
                                        <td class="small text-muted">@o.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                        <td class="pe-4 text-center">
                                            @if (o.Status == OrderStatus.Completed)
                                            {
                                                <span class="badge bg-success px-3 py-2 rounded-pill">ناجح</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">معلق</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
