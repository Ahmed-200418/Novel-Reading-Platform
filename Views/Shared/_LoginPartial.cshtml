@using Microsoft.AspNetCore.Identity
@using NovelPlatform.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center gap-2">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var isAdmin = User.IsInRole("Admin");

    if (isAdmin)
    {
        <li class="nav-item">
            <a class="btn btn-outline-warning btn-sm rounded-pill px-3 fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <i class="fas fa-chart-line ms-1"></i>لوحة التحكم (أدمن)
            </a>
        </li>
    }

    <li class="nav-item">
        <a class="btn btn-info btn-sm rounded-pill px-3 fw-bold text-white shadow-sm" asp-controller="Account" asp-action="Library">
            <i class="fas fa-bookmark ms-1"></i>مكتبتي الفصول
        </a>
    </li>

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-white fw-semibold" href="#" role="button" data-bs-toggle="dropdown">
            <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 0.9rem;">
                <i class="fas fa-user"></i>
            </div>
            <span>@(currentUser?.FullName ?? User.Identity?.Name)</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4">
            <li class="px-3 py-2 border-bottom">
                <div class="fw-bold small text-dark">@(currentUser?.FullName)</div>
                <div class="text-muted text-truncate small" style="max-width: 180px;">@(currentUser?.Email)</div>
            </li>
            <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="Library"><i class="fas fa-book-open ms-2 text-primary"></i>فصولي المشتراة</a></li>
            @if (isAdmin)
            {
                <li><a class="dropdown-item py-2 text-warning fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="fas fa-sliders ms-2"></i>إدارة الروايات والنظام</a></li>
            }
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger py-2"><i class="fas fa-right-from-bracket ms-2"></i>تسجيل الخروج</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link fw-semibold" asp-controller="Account" asp-action="Login">
            <i class="fas fa-right-to-bracket ms-1"></i>دخول
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm" asp-controller="Account" asp-action="Register">
            حساب جديد
        </a>
    </li>
}
</ul>
