@using Microsoft.AspNetCore.Identity
@using NovelPlatform.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-lg-center gap-2">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var isAdmin = User.IsInRole("Admin");

    if (isAdmin)
    {
        <li class="nav-item">
            <a class="btn btn-outline-warning btn-sm rounded-pill px-3 fw-bold d-inline-flex align-items-center gap-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                <i class="fas fa-chart-line"></i><span>لوحة التحكم (أدمن)</span>
            </a>
        </li>
    }

    <li class="nav-item">
        <a class="btn btn-info btn-sm rounded-pill px-3 fw-bold text-white shadow-sm d-inline-flex align-items-center gap-2" asp-controller="Account" asp-action="Library">
            <i class="fas fa-bookmark"></i><span>مكتبتي الفصول</span>
        </a>
    </li>

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 text-white fw-semibold" href="#" role="button" data-bs-toggle="dropdown">
            <div class="rounded-circle bg-teal text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 34px; height: 34px; font-size: 0.9rem; background-color: #0d9488;">
                <i class="fas fa-user"></i>
            </div>
            <span>@(currentUser?.FullName ?? User.Identity?.Name)</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4">
            <li class="px-3 py-2 border-bottom">
                <div class="fw-bold small text-dark">@(currentUser?.FullName)</div>
                <div class="text-muted text-truncate small" style="max-width: 180px;">@(currentUser?.Email)</div>
            </li>
            <li>
                <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-controller="Account" asp-action="Library">
                    <i class="fas fa-book-open text-teal"></i><span>فصولي المشتراة</span>
                </a>
            </li>
            @if (isAdmin)
            {
                <li>
                    <a class="dropdown-item py-2 text-warning fw-bold d-flex align-items-center gap-2" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="fas fa-sliders"></i><span>إدارة الروايات والنظام</span>
                    </a>
                </li>
            }
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger py-2 d-flex align-items-center gap-2">
                        <i class="fas fa-right-from-bracket"></i><span>تسجيل الخروج</span>
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link fw-semibold d-inline-flex align-items-center gap-2" asp-controller="Account" asp-action="Login">
            <i class="fas fa-right-to-bracket"></i><span>دخول</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm rounded-pill px-4 fw-bold shadow-sm d-inline-flex align-items-center gap-2" asp-controller="Account" asp-action="Register">
            <i class="fas fa-user-plus"></i><span>حساب جديد</span>
        </a>
    </li>
}
</ul>
