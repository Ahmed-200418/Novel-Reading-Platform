<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - منصة كِتَاب | للقراءة والشغف الإلكتروني</title>
    
    <!-- Google Arabic Fonts (Cairo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 RTL CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <!-- Custom Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top py-2">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <i class="fas fa-book-open text-info fs-3"></i>
                <span>كِتَاب</span> | منصة الروايات
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-house ms-1"></i>الرئيسية
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Novels" asp-action="Index">
                            <i class="fas fa-book-bookmark ms-1"></i>مكتبة الروايات
                        </a>
                    </li>
                </ul>

                <!-- Search Bar -->
                <form class="search-form-custom me-lg-3 my-2 my-lg-0" asp-controller="Novels" asp-action="Index" method="get">
                    <div class="search-input-wrapper">
                        <input type="text" name="search" class="form-control search-input" placeholder="ابحث عن رواية أو كاتب..." value="@ViewBag.SearchQuery">
                        <button class="search-btn" type="submit" aria-label="بحث">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>

                <!-- Auth Navigation -->
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <!-- Alert Notifications -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-4 border-0 d-flex align-items-center gap-2" role="alert">
                <i class="fas fa-circle-check fs-4"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close ms-auto me-0" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-4 border-0 d-flex align-items-center gap-2" role="alert">
                <i class="fas fa-triangle-exclamation fs-4"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close ms-auto me-0" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm rounded-4 border-0 d-flex align-items-center gap-2" role="alert">
                <i class="fas fa-circle-info fs-4"></i>
                <div>@TempData["InfoMessage"]</div>
                <button type="button" class="btn-close ms-auto me-0" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Main Body -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="d-flex align-items-center gap-2 mb-3">
                        <i class="fas fa-book-open text-info"></i> منصة كِتَاب
                    </h5>
                    <p class="small text-slate-300 leading-relaxed">
                        منصة رقمية مخصصة لقراءة الروايات والقصص بأعلى جودة وتجربة قراءة سلسة ومحمية لكل عاشق للكتُب.
                    </p>
                </div>
                <div class="col-lg-4">
                    <h5 class="mb-3">روابط سريعة</h5>
                    <ul class="list-unstyled row g-2">
                        <li class="col-6"><a href="/Novels"><i class="fas fa-chevron-left ms-1 text-info fs-7"></i>استكشف الروايات</a></li>
                        <li class="col-6"><a href="/Account/Library"><i class="fas fa-chevron-left ms-1 text-info fs-7"></i>مكتبتي الخاّصة</a></li>
                        <li class="col-6"><a href="/Admin"><i class="fas fa-chevron-left ms-1 text-info fs-7"></i>لوحة الإدارة</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <h5 class="mb-3">أمان المحتوى والدفع</h5>
                    <p class="small text-slate-300 mb-2"><i class="fas fa-shield-halved text-success me-1"></i> جميع المعاملات والفصول محمية ومقترنة بحسابك المعتمد.</p>
                    <div class="d-flex gap-2 justify-content-lg-end">
                        <span class="badge bg-secondary p-2"><i class="fab fa-cc-visa fs-5"></i></span>
                        <span class="badge bg-secondary p-2"><i class="fab fa-cc-mastercard fs-5"></i></span>
                        <span class="badge bg-secondary p-2"><i class="fas fa-wallet fs-5"></i></span>
                    </div>
                </div>
            </div>
            <hr class="my-4 border-secondary opacity-25">
            <div class="text-center small text-slate-400">
                جميع الحقوق محفوظة &copy; @DateTime.UtcNow.Year - منصة كِتَاب | MVP Production Ready
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle & Custom JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
