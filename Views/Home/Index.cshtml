@model HomeViewModel
@{
    ViewData["Title"] = "الرئيسية - عوالم القصص المُميّزة";
}

<!-- Hero Section -->
<section class="hero-wrapper py-5 text-white">
    <div class="container py-4 position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-7 text-center text-lg-start">
                <span class="badge rounded-pill px-3 py-2 mb-3 fs-6 d-inline-flex align-items-center gap-2" style="background-color: rgba(13, 148, 136, 0.15); color: #2dd4bf; border: 1px solid rgba(45, 212, 191, 0.3);">
                    <i class="fas fa-sparkles text-gold"></i><span>عالم القراءة والقصص الرقمية الفاخرة</span>
                </span>

                <h1 class="hero-title mb-4">
                    اكتشف أفضل الروايات <span class="text-gradient">وافتح الفصول الحصرية</span> فورًا
                </h1>

                <p class="hero-subtitle mb-4 leading-relaxed">
                    انغمس في عالم القصص والغموض والمغامرات مع تجربة قراءة سلسة ومحمية بالكامل بدون إعلانات. ابدأ بقراءة الفصول المجانية واشتر الفصول الحصرية بسهولة تامة.
                </p>

                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start mb-5">
                    <a href="#featured" class="btn btn-primary btn-lg rounded-pill px-4 py-3 fw-bold shadow-lg d-inline-flex align-items-center gap-2">
                        <i class="fas fa-compass fs-5"></i><span>تصفح الروايات المميزة</span>
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg rounded-pill px-4 py-3 fw-bold d-inline-flex align-items-center gap-2">
                        <i class="fas fa-user-plus fs-5"></i><span>انضم كقارئ الآن</span>
                    </a>
                </div>

                <!-- Stats Bar -->
                <div class="hero-stats-card">
                    <div class="row g-3 text-center">
                        <div class="col-4 border-end border-light border-opacity-10">
                            <h3 class="fw-black text-info mb-1">@Model.TotalNovelsCount+</h3>
                            <small class="text-slate-300 fw-semibold"><i class="fas fa-book-bookmark ms-1 text-teal"></i>رواية مكتملة ومستمرة</small>
                        </div>
                        <div class="col-4 border-end border-light border-opacity-10">
                            <h3 class="fw-black text-warning mb-1">@Model.TotalChaptersCount+</h3>
                            <small class="text-slate-300 fw-semibold"><i class="fas fa-file-lines ms-1 text-gold"></i>فصل متاح للقراءة</small>
                        </div>
                        <div class="col-4">
                            <h3 class="fw-black text-success mb-1">@Model.TotalReadersCount+</h3>
                            <small class="text-slate-300 fw-semibold"><i class="fas fa-users ms-1 text-success"></i>قارئ نشط بالمنصة</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hero Image Banner -->
            <div class="col-lg-5 text-center">
                <div class="hero-image-frame mx-auto" style="max-width: 400px;">
                    <img src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80" 
                         alt="سر المخطوطة الكونية" 
                         class="img-fluid w-100" 
                         style="height: 420px; object-fit: cover;"
                         onerror="handleImageError(this)">

                    <div class="hero-floating-badge text-white">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-warning bg-opacity-20 p-2 text-warning d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                                <i class="fas fa-star fs-5 text-gold"></i>
                            </div>
                            <div class="text-start">
                                <div class="fw-bold small text-white">سر المخطوطة الكونية</div>
                                <div class="text-slate-300 small">الأعلى قراءة هذا الأسبوع</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Platform Features Section -->
<section class="py-5 bg-white border-bottom">
    <div class="container py-3">
        <div class="text-center mb-5">
            <span class="badge bg-teal bg-opacity-10 text-teal rounded-pill px-3 py-2 fw-bold mb-2" style="background-color: rgba(13, 148, 136, 0.1); color: #0d9488;">
                <i class="fas fa-gem ms-1"></i>مميزات المنصة
            </span>
            <h2 class="fw-black text-dark">لماذا تختار منصة كِتَاب؟</h2>
            <p class="text-muted mx-auto" style="max-width: 600px;">نقدم لكل القُرّاء العرب تجربة فريدة تجمع بين القراءة الفاخرة وحماية المحتوى والدفع السلس.</p>
        </div>

        <div class="row g-4 row-cols-1 row-cols-md-3">
            <div class="col">
                <div class="feature-box">
                    <div class="feature-icon-wrapper">
                        <i class="fas fa-book-open"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">تجربة قراءة فاخرة</h5>
                    <p class="text-muted small mb-0">واجهة قراءة مريحة بدون إعلانات مزعجة، مع خيارات تخصيص حجم الخط والمظهر الليلة والدافئ.</p>
                </div>
            </div>
            <div class="col">
                <div class="feature-box">
                    <div class="feature-icon-wrapper" style="background: rgba(2, 132, 199, 0.1); color: #0284c7;">
                        <i class="fas fa-bolt"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">دفع وتفعيل فوري</h5>
                    <p class="text-muted small mb-0">شراء الفصول بضغط واحدة عبر الفيزا والبطاقات البانكية، المحافظ الإلكترونية، وفوري باي.</p>
                </div>
            </div>
            <div class="col">
                <div class="feature-box">
                    <div class="feature-icon-wrapper" style="background: rgba(245, 158, 11, 0.1); color: #f59e0b;">
                        <i class="fas fa-shield-halved"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2">محتوى حصري ومضمون</h5>
                    <p class="text-muted small mb-0">جميع الفصول المشتراة تظل محفوظة بشكل دائم في حسابك لتصل إليها من أي جهاز في أي وقت.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="py-5 bg-light border-bottom">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h4 class="fw-bold mb-0 text-dark d-inline-flex align-items-center gap-2">
                <i class="fas fa-tags text-teal"></i><span>التصنيفات والأنواع الروائية</span>
            </h4>
        </div>
        <div class="row g-3 row-cols-2 row-cols-md-4">
            @foreach (var cat in Model.Categories)
            {
                <div class="col">
                    <a asp-controller="Novels" asp-action="Index" asp-route-categoryId="@cat.Id" class="category-card">
                        <i class="@cat.IconClass"></i>
                        <h6 class="fw-bold mb-1 text-dark">@cat.Name</h6>
                        <small class="text-muted">(@cat.Novels.Count) رواية</small>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Novels Section -->
<section id="featured" class="py-5">
    <div class="container py-3">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill fw-bold mb-2 d-inline-flex align-items-center gap-2">
                    <i class="fas fa-fire text-gold"></i><span>الأعلى تقييمًا وتفاعلاً</span>
                </span>
                <h2 class="fw-bold mb-0 text-dark">الروايات المميزة</h2>
            </div>
            <a asp-controller="Novels" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 fw-bold d-inline-flex align-items-center gap-2">
                <span>استكشف الجميع</span><i class="fas fa-arrow-left me-1"></i>
            </a>
        </div>

        <div class="row g-4 row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 justify-content-center">
            @foreach (var novel in Model.FeaturedNovels)
            {
                <div class="col">
                    <div class="novel-card">
                        <div class="novel-cover-container">
                            <img src="@novel.CoverImageUrl" 
                                 class="novel-cover-img" 
                                 alt="@novel.Title"
                                 onerror="handleImageError(this)">
                            <span class="novel-badge-category">@novel.Category.Name</span>
                        </div>
                        <div class="card-body d-flex flex-column p-3">
                            <div class="d-flex align-items-center justify-content-between text-muted small mb-2">
                                <span class="d-inline-flex align-items-center gap-1"><i class="fas fa-pen-nib text-teal"></i><span>@novel.Author</span></span>
                                <span class="d-inline-flex align-items-center gap-1"><i class="fas fa-star text-warning"></i><span>@novel.Rating</span></span>
                            </div>
                            <h5 class="card-title fw-bold text-dark text-truncate mb-2" title="@novel.Title">@novel.Title</h5>
                            <p class="card-text text-muted small flex-grow-1 mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @novel.Description
                            </p>
                            <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                                <span class="d-inline-flex align-items-center gap-1 small text-muted"><i class="fas fa-book-open text-teal"></i><span>@novel.Chapters.Count فصول</span></span>
                                <a asp-controller="Novels" asp-action="Details" asp-route-id="@novel.Id" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold d-inline-flex align-items-center gap-2">
                                    <span>تصفح الرواية</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Latest Releases Section -->
<section class="py-5 bg-light">
    <div class="container py-3">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill fw-bold mb-2 d-inline-flex align-items-center gap-2">
                    <i class="fas fa-clock"></i><span>جديد المنصة</span>
                </span>
                <h2 class="fw-bold mb-0 text-dark">أحدث الإصدارات</h2>
            </div>
        </div>

        <div class="row g-4 row-cols-1 row-cols-md-2 row-cols-lg-3 justify-content-center">
            @foreach (var novel in Model.LatestNovels)
            {
                <div class="col">
                    <div class="latest-novel-card">
                        <div class="row g-0 h-100 align-items-stretch">
                            <div class="col-4 position-relative" style="min-height: 150px;">
                                <img src="@novel.CoverImageUrl" 
                                     class="w-100 h-100" 
                                     style="object-fit: cover; border-radius: 0 18px 18px 0;" 
                                     alt="@novel.Title"
                                     onerror="handleImageError(this)">
                            </div>
                            <div class="col-8">
                                <div class="card-body p-3 d-flex flex-column h-100">
                                    <span class="badge bg-teal bg-opacity-10 text-teal w-auto align-self-start mb-2 small fw-bold" style="background-color: rgba(13, 148, 136, 0.1); color: #0d9488;">@novel.Category.Name</span>
                                    <h6 class="fw-bold text-dark mb-1 text-truncate" title="@novel.Title">@novel.Title</h6>
                                    <small class="text-muted mb-2 d-inline-flex align-items-center gap-2"><i class="fas fa-user text-teal"></i><span>@novel.Author</span></small>
                                    <div class="mt-auto d-flex align-items-center justify-content-between pt-2 border-top">
                                        <small class="text-success fw-bold d-inline-flex align-items-center gap-1"><i class="fas fa-eye"></i><span>@novel.ViewsCount مشاهدة</span></small>
                                        <a asp-controller="Novels" asp-action="Details" asp-route-id="@novel.Id" class="btn btn-sm btn-outline-info rounded-pill px-3 fw-bold d-inline-flex align-items-center gap-1">
                                            <span>قراءة</span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
