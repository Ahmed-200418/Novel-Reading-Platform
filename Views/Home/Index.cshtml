@model HomeViewModel
@{
    ViewData["Title"] = "الرئيسية - عوالم القصص المُميّزة";
}

<!-- Hero Section -->
<section class="py-5 text-white position-relative overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);">
    <div class="container py-4 position-relative" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-7 text-center text-lg-start">
                <span class="badge bg-primary bg-opacity-20 text-info border border-info border-opacity-30 rounded-pill px-3 py-2 mb-3 fs-6">
                    <i class="fas fa-sparkles ms-1"></i>المنصة العربية الأولى للروايات الرقمية
                </span>
                <h1 class="display-4 fw-black mb-4 lh-base">
                    اكتشف أفضل الروايات <span class="text-gradient">وافتح الفصول الحصرية</span> فورًا
                </h1>
                <p class="fs-5 text-slate-300 mb-4 leading-relaxed opacity-90">
                    انغمس في عالم القصص، المخطوطات والغموض مع تجربة قراءة فاخرة بدون إعلانات. ابدأ قراءة الفصول المجانية واشتر الفصول المدفوعة بسهولة وأمان تام.
                </p>
                <div class="d-flex flex-wrap gap-3 justify-content-center justify-content-lg-start">
                    <a href="#featured" class="btn btn-primary btn-lg rounded-pill px-4 py-3 fw-bold shadow-lg d-flex align-items-center gap-2">
                        <i class="fas fa-compass fs-5"></i> تصفح الروايات المميزة
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg rounded-pill px-4 py-3 fw-bold d-flex align-items-center gap-2">
                        <i class="fas fa-user-plus fs-5"></i> انضم كقارئ الآن
                    </a>
                </div>

                <!-- Stats counter bar -->
                <div class="row g-3 mt-5 pt-3 border-top border-light border-opacity-10 text-center">
                    <div class="col-4">
                        <h3 class="fw-bold text-info mb-0">@Model.TotalNovelsCount+</h3>
                        <small class="text-muted">رواية مكتملة ومستمرة</small>
                    </div>
                    <div class="col-4">
                        <h3 class="fw-bold text-warning mb-0">@Model.TotalChaptersCount+</h3>
                        <small class="text-muted">فصل متاح للقراءة</small>
                    </div>
                    <div class="col-4">
                        <h3 class="fw-bold text-success mb-0">@Model.TotalReadersCount+</h3>
                        <small class="text-muted">قارئ نشط بالمنصة</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 text-center">
                <div class="position-relative d-inline-block">
                    <img src="https://images.unsplash.com/photo-1544716278-ca5e3f4abd8c?auto=format&fit=crop&w=600&q=80" alt="Novel Banner" class="img-fluid rounded-4 shadow-lg border border-secondary border-opacity-20" style="max-height: 440px; object-fit: cover;">
                    <div class="position-absolute bottom-0 start-50 translate-middle-x bg-dark bg-opacity-90 backdrop-blur text-white p-3 rounded-4 shadow-sm w-75 border border-secondary border-opacity-30 mb-n3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fas fa-star text-warning fs-5"></i>
                            <div class="text-start">
                                <div class="fw-bold small">سر المخطوطة الكونية</div>
                                <div class="text-muted small">الأعلى قراءة هذا الأسبوع</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section class="py-4 bg-white border-bottom">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-tags text-primary ms-2"></i>التصنيفات والأنواع:</h5>
        </div>
        <div class="row g-3">
            @foreach (var cat in Model.Categories)
            {
                <div class="col-6 col-md-3">
                    <a asp-controller="Novels" asp-action="Index" asp-route-categoryId="@cat.Id" class="card card-body border-0 bg-light rounded-4 text-decoration-none text-dark p-3 text-center h-100 hover-shadow transition">
                        <i class="@cat.IconClass text-primary fs-3 mb-2"></i>
                        <h6 class="fw-bold mb-1">@cat.Name</h6>
                        <small class="text-muted">(@cat.Novels.Count) رواية</small>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Novels Section -->
<section id="featured" class="py-5">
    <div class="container py-3">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <span class="badge bg-warning bg-opacity-10 text-warning px-3 py-2 rounded-pill fw-bold mb-2">
                    <i class="fas fa-fire ms-1"></i>الأعلى تقييمًا
                </span>
                <h2 class="fw-bold mb-0 text-dark">الروايات المميزة</h2>
            </div>
            <a asp-controller="Novels" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 fw-bold">
                عرض الكل <i class="fas fa-arrow-left me-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var novel in Model.FeaturedNovels)
            {
                <div class="col-12 col-sm-6 col-lg-3">
                    <div class="card novel-card">
                        <div class="novel-cover-container">
                            <img src="@novel.CoverImageUrl" class="novel-cover-img" alt="@novel.Title">
                            <span class="novel-badge-category">@novel.Category.Name</span>
                        </div>
                        <div class="card-body d-flex flex-column p-3">
                            <div class="d-flex align-items-center justify-content-between text-muted small mb-2">
                                <span><i class="fas fa-pen-nib text-primary ms-1"></i>@novel.Author</span>
                                <span><i class="fas fa-star text-warning ms-1"></i>@novel.Rating</span>
                            </div>
                            <h5 class="card-title fw-bold text-dark text-truncate mb-2" title="@novel.Title">@novel.Title</h5>
                            <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @novel.Description
                            </p>
                            <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                                <span class="small text-muted"><i class="fas fa-book-open ms-1"></i>@novel.Chapters.Count فصول</span>
                                <a asp-controller="Novels" asp-action="Details" asp-route-id="@novel.Id" class="btn btn-primary btn-sm rounded-pill px-3 fw-bold">
                                    تصفح الرواية
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- Latest Releases Section -->
<section class="py-5 bg-light">
    <div class="container py-3">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <span class="badge bg-info bg-opacity-10 text-info px-3 py-2 rounded-pill fw-bold mb-2">
                    <i class="fas fa-clock ms-1"></i>جديد المنصة
                </span>
                <h2 class="fw-bold mb-0 text-dark">أحدث الإصدارات</h2>
            </div>
        </div>

        <div class="row g-4">
            @foreach (var novel in Model.LatestNovels)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card border-0 rounded-4 shadow-sm h-100 overflow-hidden">
                        <div class="row g-0 h-100">
                            <div class="col-4 position-relative">
                                <img src="@novel.CoverImageUrl" class="w-100 h-100" style="object-fit: cover;" alt="@novel.Title">
                            </div>
                            <div class="col-8">
                                <div class="card-body p-3 d-flex flex-column h-100">
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary w-auto align-self-start mb-2 small">@novel.Category.Name</span>
                                    <h6 class="fw-bold text-dark mb-1">@novel.Title</h6>
                                    <small class="text-muted mb-2"><i class="fas fa-user ms-1"></i>@novel.Author</small>
                                    <div class="mt-auto d-flex align-items-center justify-content-between pt-2 border-top">
                                        <small class="text-success fw-bold"><i class="fas fa-eye me-1"></i>@novel.ViewsCount مشاهدة</small>
                                        <a asp-controller="Novels" asp-action="Details" asp-route-id="@novel.Id" class="btn btn-sm btn-outline-info rounded-pill px-3">
                                            قراءة
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
