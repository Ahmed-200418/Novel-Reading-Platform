@model Chapter
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    string novelTitle = ViewBag.NovelTitle as string ?? "";
    ViewData["Title"] = $"إضافة فصل جديد - {novelTitle}";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <h3 class="fw-bold text-dark mb-2"><i class="fas fa-file-circle-plus text-primary me-2"></i>إضافة فصل جديد</h3>
            <p class="text-muted small mb-4">تابع لرواية: <strong>@novelTitle</strong></p>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="NovelId" />
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label asp-for="ChapterNumber" class="form-label fw-bold">رقم الفصل</label>
                        <input asp-for="ChapterNumber" class="form-control rounded-3" required />
                    </div>
                    <div class="col-md-9">
                        <label asp-for="Title" class="form-label fw-bold">عنوان الفصل</label>
                        <input asp-for="Title" class="form-control rounded-3" placeholder="مثال: الفصل الأول: المواجهة الحاسمة" required />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-check form-switch pt-3">
                            <input asp-for="IsFree" class="form-check-input" type="checkbox" id="freeCheck" onchange="togglePriceInput(this)">
                            <label class="form-check-label fw-bold" for="freeCheck">فصل مجاني (م متاح لكافة القراء)</label>
                        </div>
                    </div>
                    <div class="col-md-6" id="priceContainer">
                        <label asp-for="Price" class="form-label fw-bold">سعر الفصل (بالجنيه المصري)</label>
                        <input asp-for="Price" class="form-control rounded-3" step="0.5" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Content" class="form-label fw-bold">محتوى الفصل والنص الروائي (يدعم فقرات HTML)</label>
                    <textarea asp-for="Content" class="form-control rounded-3" rows="12" placeholder="اكتب أو الصق نص الفصل هنا..." required></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">حفظ ونشر الفصل</button>
                    <a asp-action="Index" asp-route-novelId="@Model.NovelId" class="btn btn-light rounded-pill px-4">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function togglePriceInput(checkbox) {
            const priceContainer = document.getElementById('priceContainer');
            priceContainer.style.display = checkbox.checked ? 'none' : 'block';
        }
    </script>
}
