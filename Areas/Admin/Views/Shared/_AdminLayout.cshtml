<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - لوحة التحكم والإدارة | منصة كِتَاب</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background-color: #f1f5f9;
            color: #0f172a;
        }

        .admin-sidebar {
            width: 270px;
            background: #0f172a;
            min-height: 100vh;
            color: #94a3b8;
            box-shadow: -4px 0 20px rgba(0,0,0,0.15);
        }

        .admin-sidebar .nav-link {
            color: #cbd5e1;
            font-weight: 600;
            padding: 0.85rem 1.2rem;
            border-radius: 12px;
            margin-bottom: 6px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
        }

        .admin-sidebar .nav-link:hover, .admin-sidebar .nav-link.active {
            background: #1e293b;
            color: #38bdf8;
            transform: translateX(-3px);
        }

        .admin-content {
            flex: 1;
            padding: 2rem;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <aside class="admin-sidebar p-3 d-flex flex-column">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="d-flex align-items-center gap-2 text-white text-decoration-none py-3 px-2 mb-4 border-bottom border-secondary border-opacity-20">
                <i class="fas fa-book-open text-info fs-3"></i>
                <span class="fw-bold fs-4">لوحة الأدمن</span>
            </a>

            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="fas fa-chart-pie me-2 fs-5"></i><span>نظرة عامة وإحصائيات</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="AdminNovels" asp-action="Index">
                        <i class="fas fa-book-bookmark me-2 fs-5"></i><span>إدارة الروايات</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Transactions">
                        <i class="fas fa-money-bill-transfer me-2 fs-5"></i><span>المعاملات والإيرادات</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Users">
                        <i class="fas fa-users me-2 fs-5"></i><span>المستخدمين القُرّاء</span>
                    </a>
                </li>
            </ul>

            <hr class="border-secondary opacity-25">
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-light rounded-pill w-100 fw-bold py-2 d-flex align-items-center justify-content-center">
                <i class="fas fa-globe me-2"></i>العودة للموقع
            </a>
        </aside>

        <!-- Main Admin Content -->
        <main class="admin-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
