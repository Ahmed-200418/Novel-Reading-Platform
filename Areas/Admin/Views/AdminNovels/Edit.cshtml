@model Novel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "تعديل الرواية";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <h3 class="fw-bold text-dark mb-4"><i class="fas fa-pen-to-square text-primary me-2"></i>تعديل بيانات الرواية</h3>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedAt" />
                <input type="hidden" asp-for="ViewsCount" />
                <input type="hidden" asp-for="Rating" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold">عنوان الرواية</label>
                    <input asp-for="Title" class="form-control rounded-3" required />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Author" class="form-label fw-bold">اسم الكاتب</label>
                        <input asp-for="Author" class="form-control rounded-3" required />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="CategoryId" class="form-label fw-bold">التصنيف</label>
                        <select asp-for="CategoryId" class="form-select rounded-3" required>
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-bold">نبذة عن الرواية</label>
                    <textarea asp-for="Description" class="form-control rounded-3" rows="4" required></textarea>
                </div>

                <div class="mb-3">
                    <label asp-for="CoverImageUrl" class="form-label fw-bold">رابط صورة الغلاف</label>
                    <input asp-for="CoverImageUrl" class="form-control rounded-3" />
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <div class="form-check form-switch pt-2">
                            <input asp-for="IsPublished" class="form-check-input" type="checkbox">
                            <label class="form-check-label fw-bold" asp-for="IsPublished">منشورة للمستخدمين</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check form-switch pt-2">
                            <input asp-for="IsFeatured" class="form-check-input" type="checkbox">
                            <label class="form-check-label fw-bold" asp-for="IsFeatured">رواية مميزة</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">حفظ التغييرات</button>
                    <a asp-action="Index" class="btn btn-light rounded-pill px-4">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
