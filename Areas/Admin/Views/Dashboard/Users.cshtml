@model IEnumerable<ApplicationUser>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "قائمة القُرّاء والمستخدمين";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">المستخدمين والقُرّاء</h2>
        <p class="text-muted small">سجل الحسابات المسجلة بالفضاء التفاعلي للمنصة.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-4 py-3">الاسم الكامل</th>
                        <th>البريد الإلكتروني</th>
                        <th>تاريخ التسجيل</th>
                        <th>الفصول المشتراة</th>
                        <th>إجمالي الطلبات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px;">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <span>@u.FullName</span>
                                </div>
                            </td>
                            <td><code>@u.Email</code></td>
                            <td class="small text-muted">@u.RegisteredAt.ToString("yyyy/MM/dd")</td>
                            <td>
                                <span class="badge bg-success bg-opacity-10 text-success fw-bold rounded-pill px-3 py-1">
                                    @u.Purchases.Count فصول
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-info bg-opacity-10 text-info fw-bold rounded-pill px-3 py-1">
                                    @u.Orders.Count طلبات
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
