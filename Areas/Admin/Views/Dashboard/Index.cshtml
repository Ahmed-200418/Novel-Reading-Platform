@model AdminDashboardViewModel
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "نظرة عامة وإحصائيات المنصة";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">لوحة الإحصائيات والأداء</h2>
        <p class="text-muted small">متابعة المبيعات الحية، الفصول المشتراة وتفاعل القرّاء.</p>
    </div>
    <a asp-area="Admin" asp-controller="AdminNovels" asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
        <i class="fas fa-plus me-1"></i> إضافة رواية جديدة
    </a>
</div>

<!-- Metric Stat Cards -->
<div class="row g-4 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold">إجمالي الأرباح</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@Model.TotalRevenue.ToString("N2") ج.م</h3>
                </div>
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fas fa-coins fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold">إجمالي المشتريات</span>
                    <h3 class="fw-bold text-primary mb-0 mt-1">@Model.TotalPurchases معاملة</h3>
                </div>
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fas fa-cart-check fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold">عدد الروايات</span>
                    <h3 class="fw-bold text-info mb-0 mt-1">@Model.TotalNovels رواية</h3>
                </div>
                <div class="rounded-circle bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fas fa-book-bookmark fs-4"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-bold">القرّاء المسجلين</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1">@Model.TotalUsers قارئ</h3>
                </div>
                <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fas fa-users fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Purchases & Top Novels -->
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-0 py-3 d-flex align-items-center justify-content-between">
                <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-history text-primary me-2"></i>أحدث المشتريات والطلبات</h5>
                <a asp-action="Transactions" class="small text-primary fw-bold text-decoration-none">عرض جميع المعاملات</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small">
                            <tr>
                                <th class="ps-3">القارئ</th>
                                <th>الفصل والشراء</th>
                                <th>المبلغ</th>
                                <th class="pe-3">التاريخ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.RecentPurchases)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-dark">@(p.User?.FullName ?? p.User?.Email)</td>
                                    <td>
                                        <div class="small fw-bold">@p.Chapter?.Novel?.Title</div>
                                        <div class="text-muted small">@p.Chapter?.Title</div>
                                    </td>
                                    <td class="fw-bold text-success">@p.PricePaid.ToString("N2") ج.م</td>
                                    <td class="pe-3 small text-muted">@p.PurchasedAt.ToString("MM/dd HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-header bg-white border-0 py-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="fas fa-fire text-danger me-2"></i>أكثر الروايات قراءة</h5>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var novel in Model.TopNovels)
                    {
                        <div class="list-group-item p-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@novel.CoverImageUrl" style="width: 40px; height: 55px; object-fit: cover;" class="rounded-2 shadow-sm" alt="Cover">
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">@novel.Title</h6>
                                    <small class="text-muted"><i class="fas fa-pen-nib me-1"></i>@novel.Author</small>
                                </div>
                            </div>
                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-bold">
                                <i class="fas fa-eye me-1"></i>@novel.ViewsCount
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
