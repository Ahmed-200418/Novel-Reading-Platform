@model IEnumerable<Payment>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "سجل المعاملات والإيرادات";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">سجل المدفوعات والمعاملات</h2>
        <p class="text-muted small">تفاصيل عمليات الشراء، المراجع المصرفية وبوابات الدفع.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-4 py-3">رقم الطلب والمعاملة</th>
                        <th>القارئ</th>
                        <th>الرواية والفصل</th>
                        <th>طريقة الدفع ومزود الخادمة</th>
                        <th>المبلغ</th>
                        <th>تاريخ السداد</th>
                        <th class="pe-4 text-center">الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@p.Order?.OrderNumber</div>
                                <code class="small text-muted">@p.TransactionReference</code>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@(p.Order?.User?.FullName ?? p.Order?.User?.Email)</div>
                                <div class="small text-muted">@p.Order?.User?.Email</div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@p.Order?.Chapter?.Novel?.Title</div>
                                <div class="small text-muted">@p.Order?.Chapter?.Title</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-dark me-1">@p.PaymentMethod</span>
                                <small class="text-muted d-block">@p.Provider</small>
                            </td>
                            <td class="fw-bold text-success fs-6">@p.Amount.ToString("N2") ج.م</td>
                            <td class="small text-muted">@p.PaidAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="pe-4 text-center">
                                <span class="badge bg-success px-3 py-2 rounded-pill">ناجح</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
